<Project>
  <PropertyGroup>
    <ShareXModOverlayRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</ShareXModOverlayRoot>
    <DefineConstants>$(DefineConstants);SHAREX_MOD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ShareXModOverlayRoot)src\ShareX.ScreenCaptureLib\**\*.cs"
             Link="ShareX.ModOverlay\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(ShareXModOverlayRoot)config\ShareX.Mod.json"
          Link="ShareX.Mod.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(ShareXModOverlayRoot)config\ShareX.Mod.v04.json"
          Link="ShareX.Mod.v04.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ShareXModV04GeneratedHooks" BeforeTargets="CoreCompile">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -Command &quot;if (-not (Select-String -Quiet -SimpleMatch 'ShareXModSegmentStore segmentStore' '$(MSBuildThisFileDirectory)..\..\ShareX.ScreenCaptureLib\ScrollingCaptureManager.cs')) { &amp; '$(MSBuildThisFileDirectory)..\..\scripts\v04-manager-hooks.ps1' }&quot;" />
  </Target>
</Project>
